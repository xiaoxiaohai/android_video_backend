# =========================
# 你的后端 API 地址（采集器会把数据上传到这里）
# 例如: http://54.160.65.79:8080
# =========================
BACKEND_BASE_URL=http://54.160.65.79:8080

# =========================
# 上游来源（反编译出来的接口）
# 一般不需要改，除非对方域名变更
# =========================
UPSTREAM_BASE_URL=https://cineframeplayer.com/module-movie/

# 上游请求头：包名
UPSTREAM_REQUESTED_WITH=com.cine.frame.hd.video.player

# 上游请求头：版本号（建议与目标 APK 一致）
UPSTREAM_APP_VERSION=1.1.1

# 上游请求头：语言
UPSTREAM_LANGUAGE=en

# 上游解密密钥（ResponseInterceptor 里提取）
UPSTREAM_DECRYPT_KEY=8fOsTegF23mV43Nr6xiOisP34ZPN41WC

# 上游解密算法（Node crypto 对应写法）
UPSTREAM_DECRYPT_ALGORITHM=aes-256-cbc

# =========================
# 同步控制参数
# =========================

# =========================
# 导入到你自己的后端（上传）控制
# 说明：这些只影响发往 BACKEND_BASE_URL 的请求，不影响上游拉取速度
# =========================

# 后端上传并发数（导入多线程）
# 越大越快，但会增加 RDS/CPU 压力；建议 4~12
SYNC_BACKEND_CONCURRENCY=6

# 每次后端请求完成后额外等待（毫秒）
# 用于给后端降压；一般 0 即可
SYNC_BACKEND_REQUEST_INTERVAL_MS=0

# 后端请求失败重试次数（不包含第一次）
# 例如 2 = 最多尝试 3 次
SYNC_BACKEND_RETRY=2

# 后端重试退避基础时间（毫秒），实际等待 = base * attempt
SYNC_BACKEND_RETRY_BACKOFF_MS=400

# 每页抓取条数（建议 20~50）
SYNC_PAGE_SIZE=30

# 起始页（断点续跑）
# 全局默认起始页（不设置 movie/tv 专用时使用）
SYNC_START_PAGE=1
# movie 起始页（优先级更高）
SYNC_START_MOVIE_PAGE=1
# tv 起始页（优先级更高）
SYNC_START_TV_PAGE=1
# provider 起始页（sync:provider 用）
SYNC_START_PROVIDER_PAGE=1

# Movie 最大抓取页数
# 0 = 一直翻页，直到上游返回空页（近似全量）
# >0 = 从起始页开始，连续抓取 N 页（例如起始 565，N=10，则抓 565..574）
SYNC_MAX_MOVIE_PAGES=0

# TV 最大抓取页数
# 0 = 一直翻页，直到上游返回空页（近似全量）
# >0 = 从起始页开始，连续抓取 N 页
SYNC_MAX_TV_PAGES=0

# Provider 最大抓取页数（sync:provider 用）
# 0 = 一直翻页，直到上游返回空页（近似全量）
# >0 = 从起始页开始，连续抓取 N 页
SYNC_MAX_PROVIDER_PAGES=0

# 指定 provider 名称列表（逗号分隔）
# 为空时：自动用上游 pr/al/pr 返回的全部 provider
# 例如：netflix,hbo,prime,disney,paramount,hulu,peacock,amc
SYNC_PROVIDER_LIST=

# 详情抓取并发数（过大容易被上游限流，建议 2~4）
SYNC_DETAIL_CONCURRENCY=3

# 每次请求后暂停毫秒数（建议 200~500，降低封禁风险）
SYNC_REQUEST_INTERVAL_MS=250

# 硬上限页数（防止异常情况下无限翻页）
SYNC_HARD_PAGE_LIMIT=5000

# 检测到重复分页内容时立即停止（推荐 true）
SYNC_STOP_ON_DUPLICATE_PAGE=true

# 是否打印详细过程日志（上游请求、导入结果）
SYNC_VERBOSE_LOG=true

# =========================
# 本地落盘输出（非常重要）
# =========================

# 是否保存每次上游解密后的 JSON 到本地
SYNC_SAVE_JSON=true

# 输出目录（会按 runId 自动建子目录）
SYNC_OUTPUT_DIR=./output
